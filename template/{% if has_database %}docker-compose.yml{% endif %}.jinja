# Local infrastructure for `just dev` and manual testing. Tests start their own database
# (testcontainers), so they never touch this one.
services:
  postgres:
    image: postgres:18-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: {{ package_name }}
    ports:
      - "5432:5432"
    volumes:
      # PostgreSQL 18 images keep data under /var/lib/postgresql/<major>/docker.
      - postgres-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d {{ package_name }}"]
      interval: 2s
      timeout: 3s
      retries: 20

volumes:
  postgres-data:
