# Uniform commands (HANDBOOK §3). Requires uv{% if has_database %} and Docker{% endif %}; `just setup` once after cloning.

set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# List the recipes
default:
    @just --list

# Install dependencies and the git hooks
setup:
    uv sync
    uv run pre-commit install --install-hooks --hook-type pre-commit --hook-type commit-msg
{%- if has_web_api %}
    just openapi
{%- endif %}

# Run locally{% if has_database %} (starts PostgreSQL in Docker and applies migrations){% endif %}{% if has_web_api %} with auto-reload{% endif %}
dev:
{%- if has_database %}
    docker compose up --detach --wait postgres
    uv run alembic upgrade head
{%- endif %}
{%- if has_web_api %}
    uv run uvicorn {{ package_name }}.main:app_factory --factory --reload
{%- else %}
    uv run {{ project_slug }}
{%- endif %}

# Check formatting and lint
lint:
    uv run ruff format --check .
    uv run ruff check .

# Type-check (mypy strict)
typecheck:
    uv run mypy

# Run the tests with coverage{% if has_database %} (integration tests need Docker; skip with: just test -m "not integration"){% endif %}
test *args:
    uv run pytest --cov {% raw %}{{ args }}{% endraw %}

# Everything CI checks; must pass before anything lands on main
check: lint typecheck test

# Format and apply safe lint fixes
fmt:
    uv run ruff format .
    uv run ruff check --fix .
{%- if has_database %}

# Apply database migrations
migrate:
    uv run alembic upgrade head

# Generate a migration from model changes: just migration "add orders table"
migration message:
    uv run alembic revision --autogenerate -m "{% raw %}{{ message }}{% endraw %}"
{%- endif %}
{%- if has_web_api %}

# Regenerate the committed OpenAPI spec (a test fails when it is stale)
openapi:
    uv run python -c "from {{ package_name }}.main import write_openapi; write_openapi()"
{%- endif %}
